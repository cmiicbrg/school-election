# Copy to apps/api/.env for local development; `npm run dev:api` loads it.
# A deployment sets the same variables in its compose file.

# The origin the browser uses. In development that is the Vite dev server,
# which forwards /api to this API. Must be https except on a loopback address.
PUBLIC_ORIGIN=http://localhost:5173

HOST=127.0.0.1
PORT=3000

# info, warn or error. debug and trace work only with a loopback PUBLIC_ORIGIN
# and HOST. Error messages are never logged, at any level. The same holds for
# DEBUG, which makes dependencies print to stderr.
LOG_LEVEL=info

# Proxies whose X-Forwarded-* headers are trusted, as addresses or CIDRs
# separated by commas. Unset means loopback only.
# TRUST_PROXY=

# Directory of the built web app that the API serves. Unset means
# apps/web/dist next to this workspace; without a build the API serves /api only.
# WEB_DIST_DIR=

# Secrets are never set inline. Each one is read from the file named by its
# *_FILE variable; keep local secret files in apps/api/.secrets/, which git
# ignores. Paths are relative to apps/api.

# The server connects as the unprivileged runtime role, which the migrator
# creates and gives the password from DB_RUNTIME_PASSWORD_FILE. No password
# in the URL.
DATABASE_URL=postgres://school_election_app@127.0.0.1:5432/school_election
DATABASE_PASSWORD_FILE=.secrets/db-runtime-password

# Sign-in for teachers and witnesses with Microsoft Entra ID, single tenant:
# the directory (tenant) id and application (client) id of the app
# registration, and its client secret. Nothing contacts Entra until someone
# signs in, so development without sign-in works with these dummy values
# and a secret file holding any printable ASCII text, such as "dev". The
# redirect URI to register is
# PUBLIC_ORIGIN followed by /api/auth/callback.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET_FILE=.secrets/entra-client-secret

# Seals the session cookies: at least 32 random bytes in hex, from
# `openssl rand -hex 32`. A new key signs everyone out.
SESSION_KEY_FILE=.secrets/session-key

# Used only by `npm run migrate`, as the PostgreSQL superuser: it creates and
# adjusts the runtime role.
MIGRATION_DATABASE_URL=postgres://postgres@127.0.0.1:5432/school_election
MIGRATION_DATABASE_PASSWORD_FILE=.secrets/db-owner-password
DB_RUNTIME_PASSWORD_FILE=.secrets/db-runtime-password
