{
  "name": "@school-election/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP API for school-election; also serves the built web app.",
  "license": "MIT",
  "main": "server.ts",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.ts",
    "dev": "node --watch --env-file-if-exists=.env server.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/oauth2": "8.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/secure-session": "8.4.0",
    "@fastify/static": "10.1.5",
    "@school-election/election-core": "0.1.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
