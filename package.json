{
  "name": "school-election",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted system for anonymous, in-person school elections with Austrian Schülervertretung presets.",
  "license": "MIT",
  "author": "Christoph Stadlbauer <christoph.stadlbauer@brgenns.ac.at>",
  "workspaces": [
    "packages/election-core",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:api:fake-entra": "npm run dev:fake-entra --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "migrate": "npm run migrate --workspace apps/api",
    "verify": "node apps/api/scripts/verify.ts",
    "test": "node --test \"scripts/**/*.test.mjs\" && npm test --workspaces --if-present",
    "test:coverage": "mkdir -p coverage && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='apps/**' --test-coverage-include='packages/**' --test-coverage-include='scripts/**' --test-coverage-exclude='**/node_modules/**' --test-coverage-exclude='**/dist/**' --test-coverage-exclude='**/test/**' --test-coverage-exclude='**/*.test.*' --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout \"scripts/**/*.test.mjs\" \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\"",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "npm run lint:js && npm run lint:md && npm run lint:deps && npm run typecheck",
    "lint:js": "eslint . --max-warnings 0",
    "lint:md": "markdownlint-cli2",
    "lint:deps": "node scripts/lint-deps.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "e2e:screenshots": "SCREENSHOT_DIR=docs/anleitung/bilder/full-size playwright test"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.4",
    "@types/pngjs": "6.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsqr": "1.4.0",
    "markdownlint-cli2": "0.23.3",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vue-eslint-parser": "10.4.1"
  }
}
