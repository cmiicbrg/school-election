{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    // Node types are here for the tests (node:test, node:assert) only; the
    // ESLint config forbids src/ from importing anything outside the package.
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
