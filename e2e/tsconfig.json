{
  // The browser journeys, their harness and support, and the Playwright
  // config: Node code, type-checked by the root typecheck and seen by
  // ESLint's project service.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // DOM for what runs in the browser through page.evaluate.
    "lib": ["ES2025", "DOM"],
    "types": ["node"]
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
